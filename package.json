{
	"name": "fvtt-player-spotlight",
	"version": "1.0.0",
	"description": "A foundryVTT module that helps GMs track who is getting the spotlight during sessions and campaigns.",
	"homepage": "https://github.com/HectorCastelli/fvtt-player-spotlight#readme",
	"bugs": {
		"url": "https://github.com/HectorCastelli/fvtt-player-spotlight/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HectorCastelli/fvtt-player-spotlight.git"
	},
	"license": "Unlicense",
	"author": "Hector Castelli Zacharias <hector.zacharias@gmail.com>",
	"type": "module",
	"main": "src/main.js",
	"scripts": {
		"secret": "gitleaks git --staged --redact --no-banner --exit-code 1",
		"secret:history": "gitleaks git --redact --no-banner --exit-code 1 .",
		"secret:build": "gitleaks dir --redact --no-banner --exit-code 1 --max-archive-depth 1 dist",
		"check": "biome check",
		"format": "biome check --write",
		"localInstall": "node scripts/local-install.js",
		"bundle": "node scripts/bundle.js",
		"release": "node scripts/release.js",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.5",
		"husky": "^9.1.7",
		"simple-git": "^4.1.0",
		"yazl": "^3.3.1"
	}
}

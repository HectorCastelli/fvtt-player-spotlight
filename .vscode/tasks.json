{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start local FoundryVTT",
			"type": "npm",
			"script": "foundry:run",
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "Server started and listening on port 31234"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		}
	]
}

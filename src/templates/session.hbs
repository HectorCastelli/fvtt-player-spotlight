<section class="tab {{tabs.details.cssClass}}" data-group="sheet" data-tab="session">
    <ol class="spotlight-list">
        {{#each spotlight.players}}
        {{#with this as | player |}}
        <li data-action="spotlight" data-user-id="{{player.id}}"
            data-spotlight-count="{{../spotlight.sessions.counts.[player.id]}}"
            data-spotlight-latest="{{ifThen (eq player.id ../spotlight.session.lastPlayer) 'true' 'false'}}">
            <button type="button">
                <p>{{player.name}}</p>
                <i class="fa-solid fa-star"></i>
            </button>
        </li>
        {{/with}}
        {{/each}}
    </ol>
</section>